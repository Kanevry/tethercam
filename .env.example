# Template for the App Store Connect API credentials read by scripts/asc-api.sh
# and scripts/appstore-upload.sh.
#
# Copy this file to .env.local and fill in real values:
#
#   cp .env.example .env.local
#
# .env.local is git-ignored (see .gitignore) and must never be committed. The
# .p8 key file itself stays OUTSIDE the repository entirely (default location
# below); only the key id and issuer id, which are identifiers and not
# secrets, belong in .env.local.

ASC_KEY_ID=ABC123DEFG
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXX.p8
